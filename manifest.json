      ],
      "fields": [
        {
          "name": "window",
          "display_name": "目标窗口",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "目标窗口对象、标题或窗口句柄"
        },
        {
          "name": "mode",
          "display_name": "闪烁模式",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "Highlight",
          "presets": [
            "Highlight",
            "Taskbar",
            "Both"
          ],
          "description": "闪烁模式：屏幕边框高亮、任务栏图标闪烁或二者同时执行"
        },
        {
          "name": "color",
          "display_name": "边框高亮颜色",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "#FF3B30",
          "presets": [
            "#FF3B30",
            "#FF9500",
            "#007AFF",
            "#34C759"
          ],
          "description": "高亮边框颜色 (Hex 格式颜色代码)"
        },
        {
          "name": "count",
          "display_name": "闪烁次数",
          "intrinsic_type": "number",
          "default_type": "number",
          "default_value": "3",
          "presets": [
            "1",
            "3",
            "5"
          ],
          "description": "闪烁或高亮脉冲次数"
        },
        {
          "name": "duration",
          "display_name": "持续时间 (ms)",
          "intrinsic_type": "number",
          "default_type": "number",
          "default_value": "1000",
          "presets": [
            "500",
            "1000",
            "2000"
          ],
          "description": "高亮或闪烁的总持续时间（毫秒）"
        }
      ],
      "output_type": "bool"
    },
