      "display_name": "激活窗口 (ActiveWindow)",
      "icon": "🪟",
      "platforms": "Windows",
      "description": "将指定的软件窗口置顶并激活到最前面",
      "keywords": [
        "window",
        "active",
        "foreground",
        "激活窗口"
      ],
      "fields": [
        {
          "name": "window",
          "display_name": "目标窗口",
          "intrinsic_type": "Wnd",
          "required": true,
          "group": "窗口目标",
          "default_type": "string",
          "default_value": "",
          "presets": [
            "Foreground",
            "Desktop"
          ],
          "description": "窗口句柄或标题匹配表达式 (变量名: window)"
        },
        {
          "name": "timeout_ms",
          "display_name": "超时时间 (毫秒)",
          "intrinsic_type": "Integer",
          "group": "超时设置",
