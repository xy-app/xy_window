{
  "plugin_id": "xy_window",
  "name": "窗口管理与弹窗控制 (Window Control)",
  "version": "0.51.0",
  "group": "Window",
  "group_icon": "🪟",
  "description": "提供软件窗口的查找、激活置顶、最小化最大化、调整位置尺寸、修改标题以及弹窗自动处理等功能",
  "actions": [
    {
      "tag": "ActiveWindow",
      "display_name": "激活窗口 (ActiveWindow)",
      "icon": "🪟",
      "platforms": "All",
      "description": "将指定的软件窗口置顶并激活到最前面",
      "keywords": [
        "window",
        "active",
        "foreground",
        "激活窗口"
      ],
      "fields": [
        {
          "name": "window",
          "display_name": "目标窗口",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "",
          "presets": [
            "Foreground",
            "Desktop"
          ],
          "description": "窗口句柄或标题匹配表达式"
        }
      ],
      "output_type": "Wnd"
    },
    {
      "tag": "CloseWindow",
      "display_name": "关闭窗口 (CloseWindow)",
      "icon": "❌",
      "platforms": "All",
      "description": "向指定的软件或弹窗发送关闭指令",
      "keywords": [
        "window",
        "close",
        "destroy",
        "关闭窗口"
      ],
      "fields": [
        {
          "name": "window",
          "display_name": "目标窗口",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "窗口句柄或标题匹配表达式"
        }
      ],
      "output_type": "bool"
    },
    {
      "tag": "EnumWindows",
      "display_name": "枚举所有窗口 (EnumWindows)",
      "icon": "📑",
      "platforms": "All",
      "description": "获取电脑当前打开的所有窗口列表与标题信息",
      "keywords": [
        "window",
        "enum",
        "list",
        "枚举窗口"
      ],
      "fields": [
        {
          "name": "parent_window",
          "display_name": "父窗口",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "",
          "presets": [
            "Desktop",
            "Foreground"
          ],
          "description": "父窗口对象或句柄，留空时枚举所有顶层窗口"
        },
        {
          "name": "filter_by_title",
          "display_name": "标题过滤规则",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "根据窗口标题过滤（支持通配符），留空不进行过滤"
        },
        {
          "name": "filter_by_name",
          "display_name": "进程/类名过滤",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "根据窗口类名或进程名过滤（支持通配符），留空不进行过滤"
        },
        {
          "name": "visible",
          "display_name": "可见性筛选",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "All (全部窗口)",
          "presets": [
            "All (全部窗口)",
            "Visible (仅可见窗口)"
          ],
          "description": "窗口可见性筛选条件"
        },
        {
          "name": "sort_direction",
          "display_name": "排序规则",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "Z",
          "presets": [
            "Z",
            "XY",
            "YX"
          ],
          "description": "排序规则：Z (Z-Order顺序), XY (先横后纵), YX (先纵后横)"
        }
      ],
      "output_type": "Array"
    },
    {
      "tag": "FindWindow",
      "display_name": "查找窗口 (FindWindow)",
      "icon": "🔍",
      "platforms": "All",
      "description": "根据窗口标题文字或软件名称查找目标窗口",
      "keywords": [
        "window",
        "find",
        "search",
        "查找窗口"
      ],
      "fields": [
        {
          "name": "parent_window",
          "display_name": "父窗口",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "",
          "presets": [
            "Desktop",
            "Foreground"
          ],
          "description": "父窗口对象或句柄，留空时在整个系统桌面顶层查找"
        },
        {
          "name": "caption",
          "display_name": "窗口标题",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "目标窗口标题（支持通配符模糊匹配，如 *记事本*）"
        },
        {
          "name": "window_class",
          "display_name": "窗口类名",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "目标窗口类名（如 Notepad, Chrome_WidgetWin_1 等）"
        },
        {
          "name": "visible",
          "display_name": "可见性筛选",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "All (全部窗口)",
          "presets": [
            "All (全部窗口)",
            "Visible (仅可见窗口)"
          ],
          "description": "可见性筛选条件：默认检索全部（含隐藏窗口）；选择 Visible 仅检索可见窗口"
        },
        {
          "name": "index",
          "display_name": "匹配索引",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "0",
          "presets": [
            "0",
            "-1",
            "1"
          ],
          "description": "匹配多实例时的索引：0 表示首个匹配，-1 表示最后一个"
        }
      ],
      "output_type": "Wnd"
    },
    {
      "tag": "FlashWindow",
      "display_name": "闪烁窗口提示 (FlashWindow)",
      "icon": "✨",
      "platforms": "All",
      "description": "让指定窗口在任务栏上高亮闪烁，提醒用户注意",
      "keywords": [
        "window",
        "flash",
        "highlight",
