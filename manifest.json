{
  "plugin_id": "xy_window",
  "name": "桌面窗口管理 (Desktop Window Management)",
  "version": "0.53.0",
  "group": "Window",
  "group_icon": "🪟",
  "description": "提供桌面软件窗口的查找、激活置顶、显隐缩放、坐标与尺寸调整、标题获取及窗口树关系遍历等生命周期控制功能。",
